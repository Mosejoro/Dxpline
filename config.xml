<?xml version='1.0' encoding='utf-8'?>
<widget id="com.mosejoro.myapp" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Dxpline</name>
    <description>
        A sample Apache Cordova application that responds to the deviceready event.
    </description>
    <author email="dev@cordova.apache.org" href="https://cordova.apache.org">
        Apache Cordova Team
    </author>
    <content src="index.html" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <access origin="*" />
<allow-navigation href="*" />
<platform name="android">
    <icon src="resources/icon.png" />
    <preference name="AndroidWindowSplashScreenAnimatedIcon" value="resources/splash.png" />
    <preference name="AndroidWindowSplashScreenBackground" value="#faf8ff" />
</platform>
</widget>
